PORT=4000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# LOCAL TESTING: leave DATABASE_URL empty and the app uses an embedded Postgres
# (no install, no Docker). Data is saved in server/.pglite-data
# REAL POSTGRES: set it, e.g. postgres://postgres:postgres@localhost:5432/actify
DATABASE_URL=
# Set to true for hosted Postgres that requires SSL (Render, Neon, Supabase...)
PGSSL=false
# Only needed if the client is served from a different origin than the API
#CLIENT_ORIGIN=http://localhost:5173
